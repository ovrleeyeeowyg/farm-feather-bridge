<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMedalRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    app:cardBackgroundColor="@color/farm_surface"
    app:cardCornerRadius="@dimen/card_corner_small"
    app:cardElevation="2dp"
    app:strokeColor="@color/farm_surface_stroke"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_m">

        <com.farmfeather.bridge.core.ui.MedalRibbonView
            android:id="@+id/rowMedalRibbon"
            android:layout_width="@dimen/medal_ribbon_compact"
            android:layout_height="@dimen/medal_ribbon_compact"
            android:layout_marginEnd="@dimen/space_m" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtRowMissionName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/farm_text"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtRowMissionScore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="1"
                android:textColor="@color/farm_text_muted"
                android:textSize="@dimen/text_small" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
