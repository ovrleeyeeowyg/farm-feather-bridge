<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:endColor="#FBF6EC"
                android:startColor="#F0E4CE"
                android:type="linear" />
            <stroke
                android:width="6dp"
                android:color="@color/farm_wood" />
        </shape>
    </item>
    <item
        android:bottom="12dp"
        android:left="12dp"
        android:right="12dp"
        android:top="12dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke
                android:width="3dp"
                android:color="@color/farm_secondary" />
        </shape>
    </item>
</layer-list>
